# --- Database ---
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME

# --- Auth ---
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Frontend -> backend ---
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# --- Seed ---
ADMIN_EMAIL=admin@soulsanctuary.local
ADMIN_PASSWORD=replace-with-a-unique-strong-password
SEED_DEMO_DATA=false

# --- Social media ---
PUBLIC_APP_URL=http://localhost:8501
INSTAGRAM_URL=https://www.instagram.com/your-page
FACEBOOK_URL=https://www.facebook.com/your-page
YOUTUBE_URL=https://www.youtube.com/@your-channel
# Optional Meta Graph API sync (leave empty to use stored values)
META_ACCESS_TOKEN=
META_FACEBOOK_PAGE_ID=
META_INSTAGRAM_USER_ID=
META_SYNC_MINUTES=60
